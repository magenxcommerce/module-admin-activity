<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * Copyright © MagenX. All rights reserved.
 * SPDX-License-Identifier: MIT
 *
 * The suite covers the classes that decide WHAT gets logged and HOW values are
 * rendered - the ones where a mistake either loses an audit record or writes a
 * secret into the database. Those five classes import nothing from
 * magento/framework, on purpose: the suite therefore runs against a bare PHPUnit
 * with a two-line autoloader and does not need a Magento installation.
 *
 * Note that magenxcommerce/workflows' php-module-ci.yml does not run PHPUnit,
 * so this is a local-and-pre-push check rather than a CI gate.
 */
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="Test/Unit/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Magenx_AdminActivity unit tests">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
