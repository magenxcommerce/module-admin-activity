    <section class="admin__page-section magenx-activity-card">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Changed Fields')) ?></span>
            <span class="magenx-activity-card__count"><?= (int) count($changes) ?></span>
        </div>
        <?php if ($changes === []) : ?>
            <div class="magenx-activity-card__empty">
                <?= $escaper->escapeHtml(__('No field-level changes were recorded for this action.')) ?>
            </div>
        <?php else : ?>
            <div class="admin__table-wrapper">
                <table class="admin__table-primary magenx-activity-diff">
                    <thead>
                        <tr>
                            <th class="magenx-activity-diff__field"><?= $escaper->escapeHtml(__('Field')) ?></th>
                            <th><?= $escaper->escapeHtml(__('Old Value')) ?></th>
                            <th><?= $escaper->escapeHtml(__('New Value')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($changes as $change) : ?>
                            <tr>
                                <td class="magenx-activity-diff__field">
                                    <code><?= $escaper->escapeHtml($change['field_name']) ?></code>
                                </td>
                                <?php foreach (['old' => 'old_value', 'new' => 'new_value'] as $side => $key) : ?>
                                    <?php $value = $change[$key]; ?>
                                    <td class="magenx-activity-diff__value
                                               magenx-activity-diff__value--<?= /* @noEscape */ $side ?>">
                                        <?php if ($value === null || $value === '') : ?>
                                            <span class="magenx-activity-diff__empty">
                                                <?= $escaper->escapeHtml(__('(empty)')) ?>
                                            </span>
                                        <?php else : ?>
                                            <pre><?= $escaper->escapeHtml($value) ?></pre>
                                        <?php endif; ?>
                                    </td>
                                <?php endforeach; ?>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
