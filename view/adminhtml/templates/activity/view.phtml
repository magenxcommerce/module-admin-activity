                                <td><?= $escaper->escapeHtml($activity->getData('entity_name') ?: $na) ?></td>
                            </tr>
                            <tr>
                                <th><?= $escaper->escapeHtml(__('Entity ID')) ?></th>
                                <td><?= $escaper->escapeHtml($activity->getData('entity_id') ?: $na) ?></td>
