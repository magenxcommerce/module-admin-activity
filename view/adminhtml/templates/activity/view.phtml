                    <td><code><?= $escaper->escapeHtml($activity->getData('full_action_name') ?: $na) ?></code></td>
                </tr>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Request URL')) ?></th>
                    <td class="magenx-activity-card__wrap">
                        <?= $escaper->escapeHtml($activity->getData('request_url') ?: $na) ?>
